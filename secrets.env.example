# Secrets for the agent box — copy to ~/.config/agentbox/secrets.env
# (bootstrap.sh does this for you; keep it chmod 600, it is never tracked).
#
# Plain KEY=value shell syntax, quote values containing spaces. The file is
# exported into every interactive bash shell, the herdr server, and T3 Code,
# so their provider CLIs inherit these. After editing, restart only the
# affected service; restart herdr only while no agents are mid-task.

# OpenRouter — used by opencode and pi
#OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic — claude code (usually authenticated via `claude login` instead)
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — codex (usually authenticated via `codex login` instead)
#OPENAI_API_KEY=sk-...

# GitHub — gh / gh-axi prefer `gh auth login`; token as fallback
#GH_TOKEN=ghp_...

# Linear — personal API key for Pi's read/write Linear tools
#LINEAR_API_KEY=lin_api_...

# T3 Code — optional loopback service port override
#T3CODE_PORT=8784
